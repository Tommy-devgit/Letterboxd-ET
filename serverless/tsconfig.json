{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@letterboxd-et/server/src/app.module": ["../server/src/app.module.ts"],
      "@letterboxd-et/server/*": ["../server/*"],
      "@letterboxd-et/shared": ["../packages/shared/src"],
      "@letterboxd-et/shared/*": ["../packages/shared/*"],
      "@nestjs/*": ["../server/node_modules/@nestjs/*"],
      "@prisma/client": ["../server/node_modules/@prisma/client"],
      "class-transformer": ["../server/node_modules/class-transformer"],
      "class-validator": ["../server/node_modules/class-validator"],
      "reflect-metadata": ["../server/node_modules/reflect-metadata"],
      "rxjs": ["../server/node_modules/rxjs"]
    }
  },
  "include": ["api/**/*.ts"]
}

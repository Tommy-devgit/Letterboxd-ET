generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CreditRole {
  ACTOR
  DIRECTOR
  WRITER
  PRODUCER
  CINEMATOGRAPHER
  EDITOR
  COMPOSER
}

model User {
  id             String         @id @default(uuid())
  username       String         @unique
  email          String         @unique
  profilePicture String?
  bio            String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ratings        Rating[]
  reviews        Review[]
  watchlist      Watchlist[]
  watchedMovies  WatchedMovie[]
  favorites      Favorite[]
  lists          List[]
  followers      Follow[]       @relation("UserFollowers")
  following      Follow[]       @relation("UserFollowing")
}

model Movie {
  id             String         @id @default(uuid())
  title          String
  originalTitle  String?
  slug           String         @unique
  synopsis       String?
  releaseDate    DateTime?
  runtimeMinutes Int?
  posterUrl      String?
  backdropUrl    String?
  trailerUrl     String?
  country        String?
  language       String?
  averageRating  Float          @default(0)
  ratingsCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  genres         MovieGenre[]
  credits        MovieCredit[]
  ratings        Rating[]
  reviews        Review[]
  watchlistedBy  Watchlist[]
  watchedBy      WatchedMovie[]
  favoritedBy    Favorite[]
  listMovies     ListMovie[]
  sources        MovieSource[]
  trailers       MovieTrailer[]

  @@index([title])
  @@index([originalTitle])
  @@index([releaseDate])
}

model Genre {
  id     String       @id @default(uuid())
  name   String       @unique
  movies MovieGenre[]
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@index([genreId])
}

model Person {
  id        String        @id @default(uuid())
  fullName  String
  bio       String?
  birthDate DateTime?
  photoUrl  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  credits   MovieCredit[]

  @@index([fullName])
}

model MovieCredit {
  id            String     @id @default(uuid())
  movieId       String
  personId      String
  role          CreditRole
  characterName String?
  movie         Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person        Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([movieId, personId, role, characterName])
  @@index([movieId, role])
  @@index([personId, role])
}

model Rating {
  userId    String
  movieId   String
  rating    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  movieId    String
  content    String
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId, createdAt])
}

model Watchlist {
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
}

model WatchedMovie {
  userId    String
  movieId   String
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
}

model Favorite {
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model List {
  id          String      @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  movies      ListMovie[]

  @@index([userId])
}

model ListMovie {
  listId   String
  movieId  String
  position Int
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  movie    Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([listId, movieId])
  @@index([movieId])
}

model MovieSource {
  id          String   @id @default(uuid())
  movieId     String?
  sourceName  String
  externalId  String?
  sourceUrl   String
  scrapedData Json
  createdAt   DateTime @default(now())
  movie       Movie?   @relation(fields: [movieId], references: [id], onDelete: SetNull)

  @@index([movieId])
  @@index([sourceName, externalId])
}

model ProductionCompany {
  id        String   @id @default(uuid())
  name      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
}

model MovieTrailer {
  id         String @id @default(uuid())
  movieId    String
  title      String
  youtubeUrl String
  movie      Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

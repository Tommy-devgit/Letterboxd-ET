generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONTRIBUTOR
  MODERATOR
  ADMIN
}

enum CreditRole {
  ACTOR
  DIRECTOR
  WRITER
  PRODUCER
  CINEMATOGRAPHER
  COMPOSER
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  username       String      @unique
  displayName    String
  bio            String?
  avatarUrl      String?
  role           Role        @default(USER)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  reviews        Review[]
  ratings        Rating[]
  watchlistItems Watchlist[]
  lists          List[]
  followers      Follow[]    @relation("followers")
  following      Follow[]    @relation("following")
}

model Movie {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  originalTitle   String?
  synopsis        String?
  releaseDate     DateTime?
  runtimeMinutes  Int?
  posterUrl       String?
  trailerUrl      String?
  country         String         @default("Ethiopia")
  primaryLanguage String         @default("am")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  credits         MovieCredit[]
  genres          MovieGenre[]
  reviews         Review[]
  ratings         Rating[]
  watchlistItems  Watchlist[]
  availability    Availability[]
  listItems       ListItem[]

  @@index([title])
  @@index([originalTitle])
}

model Person {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  bio       String?
  imageUrl  String?
  bornAt    DateTime?
  credits   MovieCredit[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MovieCredit {
  movieId   String
  personId  String
  role      CreditRole
  character String?
  order     Int        @default(0)
  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([movieId, personId, role])
  @@index([personId, role])
}

model Genre {
  id     String       @id @default(cuid())
  slug   String       @unique
  name   String       @unique
  movies MovieGenre[]
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model Review {
  id               String   @id @default(cuid())
  body             String
  containsSpoilers Boolean  @default(false)
  userId           String
  movieId          String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie            Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, movieId])
  @@index([movieId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  value     Decimal  @db.Decimal(2, 1)
  userId    String
  movieId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, movieId])
  @@index([movieId])
}

model Watchlist {
  userId    String
  movieId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, movieId])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model List {
  id          String     @id @default(cuid())
  slug        String
  title       String
  description String?
  isPublic    Boolean    @default(true)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, slug])
}

model ListItem {
  listId   String
  movieId  String
  note     String?
  position Int
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  movie    Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([listId, movieId])
  @@index([movieId])
}

model Availability {
  id         String    @id @default(cuid())
  movieId    String
  provider   String
  url        String?
  region     String    @default("ET")
  accessType String
  startsAt   DateTime?
  endsAt     DateTime?
  movie      Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([movieId, region])
}

{
  "name": "letterboxd-et",
  "version": "0.1.0",
  "private": true,
  "description": "A scalable Ethiopian cinema discovery, tracking, and review platform.",
  "workspaces": [
    "client",
    "server",
    "serverless",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run start:dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:serverless": "npm --prefix serverless run build",
    "lint:client": "npm --prefix client run lint",
    "db:generate": "npm --prefix server run db:generate",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:deploy": "npm --prefix server run db:deploy",
    "db:seed": "npm --prefix server run db:seed",
    "db:import:etmdb": "npm --prefix server run db:import:etmdb",
    "db:remove:fallback": "npm --prefix server run db:remove:fallback",
    "db:hydrate": "npm --prefix server run db:hydrate",
    "db:setup": "npm --prefix server run db:setup",
    "db:studio": "npm --prefix server run db:studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
